{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyceum-reader.org/schemas/lyceum-manifest.v1.json",
  "title": "Lyceum Reader Manager work manifest v1",
  "description": "Transcribed from the partner's template 2026-09-01; replace with the plugin's own manifest.v1.schema.json when received.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "work",
    "author",
    "title",
    "latin_title",
    "language",
    "date_label",
    "route",
    "reading_route",
    "citation",
    "editions",
    "translations",
    "apparatus",
    "schema_version",
    "corpus_version"
  ],
  "properties": {
    "work": {
      "type": "string",
      "pattern": "^lyceum:[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "author": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "latin_title": { "type": ["string", "null"] },
    "language": { "enum": ["grc", "la"] },
    "date_label": { "type": ["string", "null"] },
    "route": {
      "type": "string",
      "pattern": "^/texts/[a-z0-9-]+/[a-z0-9-]+/$"
    },
    "reading_route": {
      "type": ["string", "null"],
      "pattern": "^/(read/[a-z0-9-]+/[a-z0-9-]+/section-[A-Za-z0-9.]+|[a-z0-9-]+/[a-z0-9-]+/book/[0-9]+)$"
    },
    "citation": { "$ref": "#/$defs/citation" },
    "editions": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/edition" }
    },
    "translations": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/translation" }
    },
    "apparatus": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/apparatusItem" }
    },
    "schema_version": { "const": "1.0" },
    "corpus_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-[0-9a-f]{7,40}$"
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scheme", "ranges", "extent"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "ranges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extent": { "type": ["string", "null"] }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "source", "license", "verified"],
      "properties": {
        "id": { "type": ["string", "null"], "minLength": 1 },
        "source": { "type": ["string", "null"], "minLength": 1 },
        "license": { "type": ["string", "null"] },
        "verified": { "type": "boolean" }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "translator": { "type": ["string", "null"] },
        "date": { "type": ["integer", "null"] },
        "rights": { "type": ["string", "null"] },
        "aligned": { "type": ["string", "null"] },
        "default": { "type": ["boolean", "null"] }
      }
    },
    "apparatusItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
