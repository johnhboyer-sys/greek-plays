---
// The dark-or-light switch: one half-filled disc on every page (John,
// 2026-10-20: "uniform dark/light mode icon on all pages"). The choice is
// persisted in localStorage (ThemeInit.astro reads it before paint).
import '../styles/vase.css';
---
<button
  type="button"
  class="theme-toggle ic"
  aria-label="Dark or light"
  title="Dark or light"
  aria-pressed="false"
>
  <svg class="ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="6.75"/><path class="f" d="M10 3.25a6.75 6.75 0 0 1 0 13.5z"/></svg>
</button>

<script is:inline>
  (function () {
    document.querySelectorAll('.theme-toggle').forEach(function (btn) {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      function render() {
        btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      }
      render();

      // Flip the theme. Wrapped in a View Transition so the browser
      // crossfades the whole page as one uniform fade; browsers without the
      // API (or with reduce-motion on) flip at once.
      function applyTheme() {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('ne-theme', next);
        } catch (e) {}
        document.querySelectorAll('.theme-toggle').forEach(function (b) {
          b.setAttribute('aria-pressed', String(next === 'dark'));
        });
      }

      btn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (document.startViewTransition && !reduce) {
          document.startViewTransition(applyTheme);
        } else {
          applyTheme();
        }
      });
    });
  })();
</script>

<style is:global>
  /* B's icon, not the shared stylesheet's boxed button (global.css). */
  .theme-toggle.ic {
    width: auto; height: auto; border: 0; border-radius: 0;
    background: none; color: var(--mid); padding: 0;
  }
  .theme-toggle.ic:hover, .theme-toggle.ic:focus-visible { color: var(--clay); border: 0; }
</style>
