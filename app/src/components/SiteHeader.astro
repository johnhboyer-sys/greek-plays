---
// The head on every page but the reader (docs/redesign/HANDOFF-ui-pass2-build.md
// §3.4): the site name, a link home, and at the right two icons and nothing
// else, a magnifier for search and a half-filled disc for dark or light. On a
// play page the author's name follows the site name, a link to his page.
// `stack` sets the site name in two small lines on phones (author and play
// pages; John, 2026-10-20); the desktop keeps one line.
import { SITE_NAME } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import '../styles/vase.css';

interface Props { author?: { id: string; name: string }; stack?: boolean }
const { author, stack = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// "The Greek" over "Drama Reader" when stacked.
const words = SITE_NAME.split(' ');
const cut = Math.ceil(words.length / 2);
---
<header class:list={['hd', { stack }]}>
  <span class="crumbs">
    <a class="wm" href={`${base}/`}><span>{words.slice(0, cut).join(' ')}</span> <span>{words.slice(cut).join(' ')}</span></a>
    {author && <> · <a href={`${base}/${author.id}`}>{author.name}</a></>}
  </span>
  <nav class="icons" aria-label="Site">
    <a class="ic" href={`${base}/search`} aria-label="Search" title="Search">
      <svg class="ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75"/><path d="M12.75 12.75 17.5 17.5"/></svg>
    </a>
    <ThemeToggle />
  </nav>
</header>
