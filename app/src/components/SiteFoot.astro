---
// The foot on every page but the reader (docs/redesign/HANDOFF-ui-pass2-build.md
// §3.4), one wrapping line in Alegreya Sans. It keeps pass 1's report form and
// links elsewhere (John, 2026-10-20: "Keep them all and have a link to
// johnhboyer.com"). The report form is a mail draft, as on pass 1's home page.
import '../styles/vase.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="foot">
  <nav aria-label="Resources">
    <a href={`${base}/search`}>Search the plays</a>
    <a href={`${base}/lemma/grc/`}>Greek lexicon</a>
    <a href={`${base}/attribution`}>Texts and licences</a>
    <a href={`${base}/support`}>Support</a>
    <button type="button" class="feedback-btn">Request a feature or report an error</button>
  </nav>
  <nav aria-label="Elsewhere">
    <a href="https://homer.johnhboyer.com/" target="_blank" rel="noopener">The Homer Reader ↗</a>
    <a href="https://plato.johnhboyer.com/" target="_blank" rel="noopener">The Plato Reader ↗</a>
    <a href="https://aristotle.johnhboyer.com/" target="_blank" rel="noopener">The Aristotle Reader ↗</a>
    <a href="https://johnhboyer.com" target="_blank" rel="noopener">Site by John H. Boyer</a>
  </nav>
</footer>

<div id="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title" tabindex="-1">
  <div class="fb-box">
    <h2 id="fb-title">Request a Feature / Report an Error</h2>
    <div class="fb-type">
      <label><input type="radio" name="fb-type" value="feature" checked /> Feature request</label>
      <label><input type="radio" name="fb-type" value="bug" /> Bug / error report</label>
    </div>
    <textarea id="fb-message" placeholder="Describe the feature or error…"></textarea>
    <div class="fb-actions">
      <button type="button" class="fb-cancel" id="fb-cancel">Cancel</button>
      <button type="button" class="fb-submit" id="fb-submit">Send</button>
    </div>
  </div>
</div>

<style>
  /* The form takes the menus' ink frame (John, 2026-10-20), over the page
     faded toward the paper. */
  #feedback-modal {
    display: none; position: fixed; inset: 0; z-index: 1000;
    background: color-mix(in srgb, var(--paper) 62%, transparent);
    align-items: center; justify-content: center;
  }
  #feedback-modal.open { display: flex; }
  .fb-box {
    background: var(--paper); color: var(--ink); border: 1.5px solid var(--ink);
    padding: 1.4rem 1.6rem 1.3rem; width: min(440px, calc(100vw - 2rem));
    font-family: var(--font-ui);
  }
  .fb-box h2 { margin: 0 0 1rem; font: 400 1.35rem var(--font-english); }
  .fb-type { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; margin-bottom: .9rem; }
  .fb-type label { display: flex; align-items: center; gap: .4rem; cursor: pointer; font-size: 1rem; color: var(--ink); }
  .fb-box textarea {
    width: 100%; box-sizing: border-box; min-height: 110px; resize: vertical;
    border: 1px solid var(--hair); border-radius: 0; padding: .55rem .65rem;
    font: 1rem var(--font-ui); background: var(--paper); color: var(--ink);
  }
  .fb-box textarea:focus { outline: 2px solid var(--clay); outline-offset: 0; }
  .fb-actions { display: flex; justify-content: flex-end; gap: 1.4rem; margin-top: .9rem; }
  .fb-actions button { background: none; border: 0; padding: 0; cursor: pointer; font: 400 1.05rem var(--font-ui); }
  .fb-actions .fb-cancel { color: var(--mid); }
  .fb-actions .fb-submit { color: var(--clay-text); font-weight: 500; }
  .fb-actions button:hover { text-decoration: underline; text-underline-offset: .15em; }
</style>

<script>
  const modal = document.getElementById('feedback-modal');
  const cancelBtn = document.getElementById('fb-cancel');
  const submitBtn = document.getElementById('fb-submit');
  const textarea = document.getElementById('fb-message') as HTMLTextAreaElement | null;
  let feedbackTrigger: HTMLElement | null = null;

  const open = (e?: Event) => {
    if (!modal || !textarea) return;
    feedbackTrigger = e?.currentTarget instanceof HTMLElement ? e.currentTarget : null;
    modal.classList.add('open');
    textarea.value = '';
    textarea.focus();
  };
  const close = () => {
    modal?.classList.remove('open');
    feedbackTrigger?.focus();
    feedbackTrigger = null;
  };

  document.querySelectorAll('.feedback-btn').forEach((b) => b.addEventListener('click', open));
  cancelBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('open')) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key !== 'Tab') return;
    const els = Array.from(modal.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
    )).filter((el) => !el.hasAttribute('disabled') && el.tabIndex !== -1);
    if (els.length === 0) {
      e.preventDefault();
      modal.focus();
      return;
    }
    const first = els[0];
    const last = els[els.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  submitBtn?.addEventListener('click', () => {
    const msg = textarea?.value.trim();
    if (!msg) return;
    const type = (document.querySelector('input[name="fb-type"]:checked') as HTMLInputElement).value;
    const subject = type === 'feature'
      ? 'The Greek Drama Reader: Feature Request'
      : 'The Greek Drama Reader: Bug Report';
    window.location.href =
      `mailto:jhboyer@loyno.edu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(msg)}`;
    close();
  });
</script>
