---
// The site's home page — the author catalogue.
import { getWork, workLanding, authorPath, type Work } from '@shared/lib/works';
import { AUTHORS } from '@shared/lib/authors';
import { SITE_NAME } from '../lib/site';
import ThemeInit from './ThemeInit.astro';
import Pwa from './Pwa.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { jsonLdSafe } from '../lib/jsonld';
import { isBuilt } from '../lib/built-works';
import SiteHeader from './SiteHeader.astro';
import SiteFoot from './SiteFoot.astro';
import Figure from './Figure.astro';
import { drawing } from '../lib/drawings';
import '@shared/styles/global.css';
import '../styles/vase.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// DRAFT copy: John approves.
// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the Greek plays in the original Greek with a facing English' +
  ' translation, side by side — with click-to-parse morphology, dictionary' +
  ' lookup, citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;

// The frieze: every author with at least one built work, in authors.yaml
// order, with the play count and the home-page figure where one is drawn
// (an author with no figure keeps the figure's space empty). The registry
// may list works whose data isn't built in this checkout: only works with
// public/data/<id>/manifest.json count (see built-works.ts).
const playwrights = AUTHORS
  .map((author) => ({
    author,
    works: author.works
      .map((id) => getWork(id))
      .filter((w): w is Work => Boolean(w) && isBuilt(w.id)),
  }))
  .filter((p) => p.works.length > 0);

// Every figure one height (John, 2026-10-20: "I do like how all the images
// are equal height"): each column as wide as its figure's aspect ratio, in
// fr, so the four stand at ONE height and none is shrunk to a quarter; the
// height drops only when the four together would not fit the width. Phones
// set them two by two, so the wider pair bounds the height there. An author
// with no figure keeps an empty space of the mock's .7 ratio.
const ratios = playwrights.map(({ author }) => {
  const d = drawing(author.id);
  return d ? d.width / d.height : 0.7;
});
const sum = ratios.reduce((a, b) => a + b, 0);
const pairs = [ratios.slice(0, 2), ratios.slice(2, 4)].map((p) => p.reduce((a, b) => a + b, 0));
const friezeVars = `--cols:${ratios.map((r) => `${r.toFixed(3)}fr`).join(' ')};--sum:${sum.toFixed(3)};--pairmax:${Math.max(...pairs).toFixed(3)}`;

// Structured data: identify the site (WebSite) and enumerate every built work as
// an ItemList of CreativeWorks linking to its landing page. This tells Google the
// home page is the hub for the whole corpus, reinforcing the per-work pages that
// carry the long-tail "<work> greek english" queries. Absolute URLs need
// Astro.site (set in config); emitted only when present.
const builtWorks = playwrights.flatMap((p) => p.works);
const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: `${SITE_NAME} — Corpus`,
        numberOfItems: builtWorks.length,
        itemListElement: builtWorks.map((w, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: w.title,
          url: new URL(`${base}${workLanding(w.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- TODO: register this property in Google Search Console and add its
       verification token here (a sibling reader's token was intentionally
       removed from this file — it belongs to a different GSC property). -->
  <ThemeInit />
  <title>{SITE_NAME} — Greek tragedy and comedy, Greek and English side by side</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${SITE_NAME} — Greek tragedy and comedy, Greek and English side by side`} />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content={SITE_NAME} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${SITE_NAME} — Greek tragedy and comedy, Greek and English side by side`} />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body class="home">
  <CommandPalette client:load />
  <div class="wrap">
    <SiteHeader />

    <main>
      <h1 class="visually-hidden">{SITE_NAME}</h1>

      <div class="frieze" style={friezeVars}>
        {playwrights.map(({ author, works }) => (
          <div class="col">
            {/* The figure opens the author's page too (John, 2026-10-21); the
                name below is the link for keyboards and screen readers. */}
            <a class="fl" href={`${base}${authorPath(author.id)}`} tabindex="-1" aria-hidden="true"><Figure slug={author.id} /></a>
            <div class="nm">
              <span class="gk" lang="grc">{author.nativeName}</span>
              <a class="en" href={`${base}${authorPath(author.id)}`}>{author.name}</a>
              <span class="ct">{works.length} play{works.length === 1 ? '' : 's'}</span>
            </div>
          </div>
        ))}
      </div>

      {/* Every title, as a run under each name, never a list (John,
          2026-10-20: "the lists are LONG and vertical and remove reason to
          go to author pages"). The runs sit in the frieze's own columns. */}
      <div class="runs" style={friezeVars}>
        {playwrights.map(({ author, works }) => (
          <p class="run"><b>{author.name}:</b> {works.map((w, i) => (
            <>{i > 0 && ', '}<a href={`${base}${workLanding(w.id)}`}>{w.title}</a></>
          ))}</p>
        ))}
      </div>
    </main>

    <SiteFoot />
  </div>

  <style>
    /* The home page (docs/redesign/HANDOFF-ui-pass2-build.md §4): A's frieze
       in B's colours, every figure one height. */
    .frieze {
      display: grid; grid-template-columns: var(--cols, repeat(4, minmax(0, 1fr)));
      --fig-h: min(300px, calc((100vw - 10rem) / var(--sum, 4)));
      margin-top: 1.6rem;
    }
    .col { min-width: 0; }
    .fl { display: block; color: inherit; }
    .nm { text-align: center; padding: 1.1rem .4rem 0; }
    .gk { display: block; font: 400 1.5rem/1.1 var(--font-greek); color: var(--clay-deep); }
    .en { display: block; font: 400 2.8rem/1.05 var(--font-english); color: var(--ink); text-decoration: none; }
    .en:hover { text-decoration: underline; text-underline-offset: .12em; }
    .ct { display: block; font: 400 1rem var(--font-ui); color: var(--mid); margin-top: .3rem; }

    /* No column gap: the tracks match the frieze's, so each run sits under
       its name; narrow, so it wraps into several lines. */
    .runs { display: grid; grid-template-columns: var(--cols, repeat(4, minmax(0, 1fr))); gap: 0; margin-top: 1.4rem; }
    .run {
      font: 400 1.02rem/1.45 var(--font-english); text-align: center;
      padding: 0 .7rem; min-width: 0; max-width: 16em; margin: 0 auto;
    }
    .run b {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .run a { color: var(--ink); text-decoration: none; }
    .run a:hover { text-decoration: underline; text-underline-offset: .12em; }

    /* Phone: the frieze two by two, the wider pair bounding the height; the
       runs one column, each led by the author's name. */
    @media (max-width: 700px) {
      .frieze {
        grid-template-columns: 1fr 1fr; row-gap: 1.6rem;
        --fig-h: min(170px, calc((100vw - 3rem) / var(--pairmax, 2)));
      }
      /* Under 24px the Greek takes the darker clay (AA for small text). */
      .gk { font-size: 1.15rem; color: var(--clay-text); }
      .en { font-size: 1.7rem; }
      .runs { grid-template-columns: 1fr; gap: .8rem; }
      .run { text-align: left; padding: 0; font-size: 1rem; max-width: none; margin: 0; }
      .run b {
        position: static; width: auto; height: auto; margin: 0; overflow: visible;
        clip: auto; white-space: normal; font-weight: 400; color: var(--mid);
      }
    }
  </style>
</body>
</html>
