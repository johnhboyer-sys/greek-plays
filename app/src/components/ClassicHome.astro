---
// The site's home page — the author catalogue.
import { getWork, workLanding, authorPath, type Work } from '@shared/lib/works';
import { AUTHORS } from '@shared/lib/authors';
import { SITE_NAME } from '../lib/site';
import ThemeInit from './ThemeInit.astro';
import ThemeToggle from './ThemeToggle.astro';
import Pwa from './Pwa.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { jsonLdSafe } from '../lib/jsonld';
import { isBuilt } from '../lib/built-works';
import { drawing } from '../lib/drawings';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// DRAFT copy: John approves.
// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the Greek plays in the original Greek with a facing English' +
  ' translation, side by side — with click-to-parse morphology, dictionary' +
  ' lookup, citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;

// The frieze: every author with at least one built work, in authors.yaml
// order, with the play count and the home-page figure where one is drawn
// (an author with no figure keeps the figure's space empty). The registry
// may list works whose data isn't built in this checkout: only works with
// public/data/<id>/manifest.json count (see built-works.ts).
const playwrights = AUTHORS
  .map((author) => ({
    author,
    works: author.works
      .map((id) => getWork(id))
      .filter((w): w is Work => Boolean(w) && isBuilt(w.id)),
    fig: drawing(author.id),
  }))
  .filter((p) => p.works.length > 0);

// Structured data: identify the site (WebSite) and enumerate every built work as
// an ItemList of CreativeWorks linking to its landing page. This tells Google the
// home page is the hub for the whole corpus, reinforcing the per-work pages that
// carry the long-tail "<work> greek english" queries. Absolute URLs need
// Astro.site (set in config); emitted only when present.
const builtWorks = playwrights.flatMap((p) => p.works);
const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: `${SITE_NAME} — Corpus`,
        numberOfItems: builtWorks.length,
        itemListElement: builtWorks.map((w, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: w.title,
          url: new URL(`${base}${workLanding(w.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- TODO: register this property in Google Search Console and add its
       verification token here (a sibling reader's token was intentionally
       removed from this file — it belongs to a different GSC property). -->
  <ThemeInit />
  <title>{SITE_NAME} — Greek tragedy and comedy, Greek and English side by side</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${SITE_NAME} — Greek tragedy and comedy, Greek and English side by side`} />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content={SITE_NAME} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${SITE_NAME} — Greek tragedy and comedy, Greek and English side by side`} />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body class="home">
  <CommandPalette client:load />
  <div class="frieze-page">
    <header class="hd">
      <a class="wm" href={`${base}/`}>{SITE_NAME}</a>
      <nav aria-label="Site">
        <a
          class="resume"
          id="resume-link"
          href="#"
          hidden
          data-works={JSON.stringify(Object.fromEntries(
            builtWorks.map((w) => [w.id, { title: w.title, books: w.books }]),
          ))}
        >Resume</a>
        <a href={`${base}/search`}>Search</a>
        <ThemeToggle />
      </nav>
    </header>

    <main>
      <h1 class="visually-hidden">{SITE_NAME}</h1>
      {/* DRAFT copy (the round-3 sketch's line): John approves. */}
      <p class="intro">The 44 surviving Greek plays, in Greek and English, with several translations of each.</p>

      <div class="row">
        {playwrights.map(({ author, works, fig }) => (
          <div class="c" data-author={author.id}>
            <div class="fb">
              {fig && (
                <svg
                  class="fig"
                  viewBox={fig.viewBox}
                  preserveAspectRatio="xMidYMax meet"
                  style={`aspect-ratio:${fig.width}/${fig.height}`}
                  role="img"
                  aria-label={fig.alt}
                ><use href={`${base}/drawings/${fig.name}.svg#fig`} /></svg>
              )}
            </div>
            <div class="txt">
              <a class="nm" href={`${base}${authorPath(author.id)}`}>
                <span class="gk" lang="grc">{author.nativeName}</span>
                <span class="en">{author.name}</span>
              </a>
              <a class="meta" href={`${base}${authorPath(author.id)}`}>{works.length} play{works.length === 1 ? "" : "s"} →</a>
            </div>
          </div>
        ))}
      </div>
    </main>

    <footer class="home-foot">
      <nav aria-label="Resources">
        <a href={`${base}/search`}>Search the plays</a>
        <a href={`${base}/lemma/grc/`}>Greek lexicon</a>
        <a href={`${base}/attribution`}>Texts and licences</a>
        <a href={`${base}/support`}>Support</a>
        <button id="feedback-btn">Request a feature or report an error</button>
      </nav>
      <nav aria-label="Elsewhere">
        <a href="https://johnhboyer-sys.github.io/plato-reader/" target="_blank" rel="noopener">The Plato Reader ↗</a>
        <a href="https://johnhboyer-sys.github.io/aristotle-reader/" target="_blank" rel="noopener">The Aristotle Reader ↗</a>
        <a href="https://x.com/johnhboyer" target="_blank" rel="noopener">Site by John H. Boyer</a>
      </nav>
    </footer>
  </div>

  <style>
    /* The frieze home page (docs/redesign/DESIGN.md, Home page; sketch
       home-sketches-round3.html, version A). Warm paper, no author tint, no
       rules or boxes but the ground line the figures stand on. */
    body.home {
      --paper: #fbf9f4;
      --ink: #1b1c1f;
      --ink-mid: #5c6064;
      --link: #6d385a;
      /* Dark lines on Attic orange, as on a red-figure vase, in both themes
         (John, 2026-10-13). */
      --fig-ink: #1b1916;
      --fig-body: #d4875a;
      background: var(--paper);
      color: var(--ink);
      font-family: "Alegreya Sans", system-ui, sans-serif;
    }
    :root[data-theme="dark"] body.home {
      --paper: #1c1a17;
      --ink: #e8e1d3;
      --ink-mid: #b9b0a1;
      --link: #d7a3c4;
    }
    .frieze-page { max-width: 80rem; margin: 0 auto; padding: 0 3.5rem 3.5rem; }
    .frieze-page a { color: inherit; text-decoration: none; }
    .frieze-page a:hover { text-decoration: underline; }

    .hd {
      display: flex; justify-content: space-between; align-items: baseline;
      padding: 1.4rem 0 1.1rem; font-size: 1.06rem;
    }
    .wm { font-family: Cardo, serif; font-size: 1.3rem; }
    .hd nav { display: flex; gap: 1.6rem; align-items: baseline; }
    .hd .resume { color: var(--link); }
    .hd .resume[hidden] { display: none; }
    .hd :global(.theme-toggle) { align-self: center; }

    .intro {
      font: 400 1.3rem/1.4 Cardo, serif; color: var(--ink-mid);
      margin: .6rem 0 2.1rem;
    }

    /* Figure height: the sketch's 330px, or the column's width where that is
       less, so a wide figure (Euphorbos' spear) never reaches its
       neighbours. */
    .row {
      --fig-h: min(20.6rem, calc((min(100vw, 80rem) - 7rem) / 4));
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .c { min-width: 0; }
    .fb {
      height: calc(var(--fig-h) + .65rem); border-bottom: 2px solid var(--ink);
      display: flex; align-items: flex-end; justify-content: center;
      padding: 0 .6rem;
    }
    .fig {
      /* Every figure stands the same height; a wide one may reach a little
         past its column, into the space beside its neighbour. */
      display: block; height: var(--fig-h); width: auto; flex: none;
      color: var(--fig-ink); fill: currentColor;
    }
    .txt { padding: 1.25rem .4rem 0; text-align: center; }
    .nm { display: block; }
    .gk { display: block; font-family: var(--font-greek); font-size: min(1.9rem, 2.1vw); line-height: 1.1; color: var(--ink-mid); }
    .en { display: block; font-family: Cardo, serif; font-size: min(2.9rem, 3.1vw); line-height: 1.05; }
    .frieze-page .meta { display: inline-block; margin-top: .25rem; color: var(--link); font-size: 1rem; }

    .home-foot {
      margin-top: 4rem; display: flex; flex-direction: column; gap: .6rem;
      align-items: center; font-size: 1rem; color: var(--ink-mid);
    }
    .home-foot nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.6rem; }
    .home-foot a { color: var(--ink-mid); }
    .home-foot button {
      background: none; border: none; padding: 0; cursor: pointer;
      font: inherit; color: var(--ink-mid);
    }
    .home-foot button:hover { text-decoration: underline; }

    .visually-hidden {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }

    /* Each author's name and count in his colour: DESIGN.md's author tints,
       the dark values lifted to pass AA (John, 2026-10-13: "too black and
       white"; he picked these with the Attic orange figures). */
    .c[data-author="aeschylus"]    { --tint-ink: #34536b; }
    .c[data-author="sophocles"]    { --tint-ink: #43603b; }
    .c[data-author="euripides"]    { --tint-ink: #8a3f30; }
    .c[data-author="aristophanes"] { --tint-ink: #6e5114; }
    :root[data-theme="dark"] .c[data-author="aeschylus"]    { --tint-ink: #9db8cf; }
    :root[data-theme="dark"] .c[data-author="sophocles"]    { --tint-ink: #a9c39e; }
    :root[data-theme="dark"] .c[data-author="euripides"]    { --tint-ink: #e3a493; }
    :root[data-theme="dark"] .c[data-author="aristophanes"] { --tint-ink: #d9bb7c; }
    .en, .frieze-page .meta { color: var(--tint-ink); }

    /* Narrow screens (and 200% zoom): the frieze becomes two pairs of
       figures. */
    @media (max-width: 64rem) {
      .row {
        --fig-h: min(20.6rem, calc((100vw - 7rem) / 2));
        grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem;
      }
      .gk { font-size: 1.6rem; }
      .en { font-size: 2.4rem; }
    }
    /* Phone. */
    @media (max-width: 40rem) {
      .frieze-page { padding: 0 1rem 2rem; }
      .hd { flex-direction: column; gap: .4rem; padding: 1rem 0 .6rem; }
      .hd nav { gap: 1.1rem; font-size: 1rem; }
      .intro { font-size: 1.12rem; margin: .4rem 0 1.4rem; }
      .row { --fig-h: 11.25rem; row-gap: 1.75rem; }
      /* At this size the finer pen lines fade without a hairline stroke
         (docs/redesign/drawings/README.md). */
      .fig { stroke: currentColor; stroke-width: .5px; }
      .txt { padding: .75rem .25rem 0; }
      .gk { font-size: 1.2rem; }
      .en { font-size: 1.75rem; }
      .frieze-page .meta { font-size: .94rem; }
      .home-foot { margin-top: 2.5rem; }
    }

    /* Feedback modal */
    #feedback-modal {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,.45); align-items: center; justify-content: center;
    }
    #feedback-modal.open { display: flex; }
    .fb-box {
      background: var(--page-bg); border: 1px solid var(--rule);
      border-radius: 8px; padding: 1.75rem 2rem; width: min(440px, 90vw);
      font-family: var(--font-ui); box-shadow: 0 8px 32px rgba(0,0,0,.18);
    }
    .fb-box h2 {
      margin: 0 0 1.1rem; font-size: 1rem; font-weight: 600; color: var(--text);
    }
    .fb-type { display: flex; gap: 1.25rem; margin-bottom: 1rem; }
    .fb-type label { display: flex; align-items: center; gap: .4rem; cursor: pointer;
      font-size: .875rem; color: var(--text); }
    .fb-box textarea {
      width: 100%; box-sizing: border-box; min-height: 110px; resize: vertical;
      border: 1px solid var(--rule); border-radius: 4px; padding: .6rem .75rem;
      font-family: var(--font-ui); font-size: .875rem;
      background: var(--page-bg); color: var(--text);
    }
    .fb-box textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .fb-actions { display: flex; justify-content: flex-end; gap: .6rem; margin-top: .9rem; }
    .fb-cancel {
      background: none; border: 1px solid var(--rule); border-radius: 4px;
      padding: .4rem .9rem; cursor: pointer; font: inherit; font-size: .85rem;
      color: var(--text-mid);
    }
    .fb-cancel:hover { border-color: var(--text-mid); }
    .fb-submit {
      background: var(--accent); color: var(--on-accent); border: none; border-radius: 4px;
      padding: .4rem 1rem; cursor: pointer; font: inherit; font-size: .85rem;
      font-weight: 600;
    }
    .fb-submit:hover { opacity: .88; }
    .fb-submit:disabled { opacity: .45; cursor: default; }
  </style>

  <!-- Feedback modal -->
  <div id="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title" tabindex="-1">
    <div class="fb-box">
      <h2 id="fb-title">Request a Feature / Report an Error</h2>
      <div class="fb-type">
        <label><input type="radio" name="fb-type" value="feature" checked /> Feature request</label>
        <label><input type="radio" name="fb-type" value="bug" /> Bug / error report</label>
      </div>
      <textarea id="fb-message" placeholder="Describe the feature or error…"></textarea>
      <div class="fb-actions">
        <button class="fb-cancel" id="fb-cancel">Cancel</button>
        <button class="fb-submit" id="fb-submit">Send</button>
      </div>
    </div>
  </div>

  <script>
    // Hoisted scripts run on whichever home page this route rendered, so every
    // lookup is optional: the Lyceum branch (PUBLIC_LYCEUM_CHROME=1) has no
    // feedback modal. Same defensive idiom as ReaderShell.astro's chrome script.
    const modal = document.getElementById('feedback-modal');
    const openBtn = document.getElementById('feedback-btn');
    const cancelBtn = document.getElementById('fb-cancel');
    const submitBtn = document.getElementById('fb-submit');
    const textarea = document.getElementById('fb-message') as HTMLTextAreaElement | null;
    let feedbackTrigger: HTMLElement | null = null;

    const open = (e?: Event) => {
      if (!modal || !textarea) return;
      feedbackTrigger = e?.currentTarget instanceof HTMLElement ? e.currentTarget : null;
      modal.classList.add('open');
      textarea.value = '';
      textarea.focus();
    };
    const close = () => {
      modal?.classList.remove('open');
      feedbackTrigger?.focus();
      feedbackTrigger = null;
    };

    openBtn?.addEventListener('click', open);
    cancelBtn?.addEventListener('click', close);
    modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('open')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const els = Array.from(modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )).filter((el) => !el.hasAttribute('disabled') && el.tabIndex !== -1);
      if (els.length === 0) {
        e.preventDefault();
        modal.focus();
        return;
      }
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    submitBtn?.addEventListener('click', () => {
      const msg = textarea?.value.trim();
      if (!msg) return;
      const type = (document.querySelector('input[name="fb-type"]:checked') as HTMLInputElement).value;
      const subject = type === 'feature'
        ? 'The Greek Drama Reader: Feature Request'
        : 'The Greek Drama Reader: Bug Report';
      window.location.href =
        `mailto:jhboyer@loyno.edu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(msg)}`;
      close();
    });
  </script>

  <script>
    // Resume link in the header: shown only when the reader has saved a
    // recent position (localStorage, see shared/lib/resume.ts), pointing back
    // into the reader at the remembered book and citation.
    import { lastRead, resumeHref } from '@shared/lib/resume';

    const link = document.getElementById('resume-link') as HTMLAnchorElement | null;
    if (link) {
      const works: Record<string, { title: string; books: number }> =
        JSON.parse(link.dataset.works || '{}');
      const last = lastRead((w) => w in works);
      if (last) {
        const w = works[last.work];
        const book = Math.min(Math.max(1, last.book), w.books);
        // Astra lane A, F8: a later occurrence is saved as "803--2" so the
        // hash lands on the second 803; drop that suffix from the displayed
        // resume text. The href keeps the full cite.
        const displayCite = last.cite ? last.cite.replace(/--\d+$/, '') : null;
        const where = displayCite ?? (w.books > 1 ? `Book ${book}` : '');
        link.textContent = `Resume: ${w.title}${where ? ` ${where}` : ''}`;
        const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
        link.href = resumeHref(last.work, { ...last, book }, base);
        link.hidden = false;
      }
    }
  </script>

</body>
</html>
