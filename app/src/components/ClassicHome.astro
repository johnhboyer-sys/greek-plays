---
// The site's home page — the author catalogue.
import { getWork, workLanding, authorPath, type Work } from '@shared/lib/works';
import { AUTHORS } from '@shared/lib/authors';
import { SITE_NAME } from '../lib/site';
import ThemeInit from './ThemeInit.astro';
import Pwa from './Pwa.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { jsonLdSafe } from '../lib/jsonld';
import { isBuilt } from '../lib/built-works';
import SiteHeader from './SiteHeader.astro';
import SiteFoot from './SiteFoot.astro';
import Figure from './Figure.astro';
import { drawing } from '../lib/drawings';
import '@shared/styles/global.css';
import '../styles/vase.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// A home figure's width over its height (an author without one keeps .75).
const figRatio = (id: string) => { const d = drawing(id); return d ? (d.width / d.height).toFixed(3) : '0.750'; };

// DRAFT copy: John approves.
// Home-page SEO + social card (absolute URLs need Astro.site, set in config).
const homeDescription =
  'Read the Greek plays in the original Greek with a facing English' +
  ' translation, side by side — with click-to-parse morphology, dictionary' +
  ' lookup, citation, and full-text search across the corpus.';
const canonical = Astro.site ? new URL(`${base}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;

// The frieze: every author with at least one built work, in authors.yaml
// order, with the play count and the home-page figure where one is drawn
// (an author with no figure keeps the figure's space empty). The registry
// may list works whose data isn't built in this checkout: only works with
// public/data/<id>/manifest.json count (see built-works.ts).
const playwrights = AUTHORS
  .map((author) => ({
    author,
    works: author.works
      .map((id) => getWork(id))
      .filter((w): w is Work => Boolean(w) && isBuilt(w.id)),
  }))
  .filter((p) => p.works.length > 0);

// Structured data: identify the site (WebSite) and enumerate every built work as
// an ItemList of CreativeWorks linking to its landing page. This tells Google the
// home page is the hub for the whole corpus, reinforcing the per-work pages that
// carry the long-tail "<work> greek english" queries. Absolute URLs need
// Astro.site (set in config); emitted only when present.
const builtWorks = playwrights.flatMap((p) => p.works);
const structuredData = Astro.site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        url: new URL(`${base}/`, Astro.site).href,
        description: homeDescription,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: `${SITE_NAME} — Corpus`,
        numberOfItems: builtWorks.length,
        itemListElement: builtWorks.map((w, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: w.title,
          url: new URL(`${base}${workLanding(w.id)}/`, Astro.site).href,
        })),
      },
    ]
  : null;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- TODO: register this property in Google Search Console and add its
       verification token here (a sibling reader's token was intentionally
       removed from this file — it belongs to a different GSC property). -->
  <ThemeInit />
  <title>{SITE_NAME} — Greek tragedy and comedy, Greek and English side by side</title>
  <meta name="description" content={homeDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${SITE_NAME} — Greek tragedy and comedy, Greek and English side by side`} />
  <meta property="og:description" content={homeDescription} />
  <meta property="og:site_name" content={SITE_NAME} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${SITE_NAME} — Greek tragedy and comedy, Greek and English side by side`} />
  <meta name="twitter:description" content={homeDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {structuredData && structuredData.map((sd) => (
    <script type="application/ld+json" set:html={jsonLdSafe(sd)} />
  ))}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body class="home">
  <CommandPalette client:load />
  <div class="wrap">
    <SiteHeader />

    <main>
      <h1 class="visually-hidden">{SITE_NAME}</h1>

      {/* One row per author (John, 2026-10-23, from the rows mockup: "let's
          go with that layout"): the figure on the row's ground line, the
          names beside it, the plays in short columns, so Euripides' nineteen
          no longer make the page long. The figure opens the author's page
          too; the name is the link for keyboards and screen readers. */}
      {playwrights.map(({ author, works }) => (
        <section class="row">
          <a class="fl" data-a={author.id} href={`${base}${authorPath(author.id)}`} tabindex="-1" aria-hidden="true" style={`--r:${figRatio(author.id)}`}><Figure slug={author.id} /></a>
          <div class="nm">
            <span class="gk" lang="grc">{author.nativeName}</span>
            <a class="en" href={`${base}${authorPath(author.id)}`}>{author.name}</a>
            <span class="ct">{works.length} play{works.length === 1 ? '' : 's'}</span>
          </div>
          <ul class="plays" aria-label={`${author.name}'s plays`}>
            {works.map((w) => <li><a href={`${base}${workLanding(w.id)}`}>{w.title}</a></li>)}
          </ul>
        </section>
      ))}
    </main>

    <SiteFoot />
  </div>

  <style>
    /* The rows: figure, names, and plays on one ground line. */
    main { margin-top: 1.2rem; }
    .row {
      display: flex; flex-wrap: wrap; align-items: flex-end; column-gap: 1.8rem;
      border-bottom: 2px solid var(--line); padding-top: 1.6rem;
      --fig-h: 200px; --fig-lift: 0px;
    }
    .fl { flex: 0 0 auto; display: block; color: inherit; }
    .row :global(.fb) { border-bottom: 0; }
    /* On phones Figure.astro makes .fb a size container (for its small-
       figure hairline), and a size container takes no width from its
       content: so the box gets its width from the drawing's proportions
       (--r, set per author below), or the figure is 0 wide. */
    .fl { width: calc(var(--fig-h) * var(--r, .75)); }
    .nm { flex: 0 0 auto; min-width: 11.5rem; padding-bottom: .9rem; }
    .gk { display: block; font: 400 1.5rem/1.1 var(--font-greek); color: var(--clay-deep); }
    .en { display: block; font: 400 2.6rem/1.05 var(--font-english); color: var(--ink); text-decoration: none; }
    .en:hover { text-decoration: underline; text-underline-offset: .12em; }
    .ct { display: block; font: 400 1rem var(--font-ui); color: var(--mid); margin-top: .3rem; }
    .plays {
      flex: 1 1 15rem; min-width: 0; margin: 0; padding: 0 0 .9rem; list-style: none;
      columns: 8em 3; column-gap: 1.6rem; font: 400 1.05rem/1.45 var(--font-english);
    }
    .plays li { break-inside: avoid; }
    .plays a { color: var(--ink); text-decoration: none; }
    .plays a:hover { text-decoration: underline; text-underline-offset: .12em; }

    /* Tablet: a smaller figure and name; the plays keep three columns where
       each has 8em, else two. */
    @media (max-width: 1000px) {
      .row { --fig-h: 170px; }
      .nm { min-width: 9.5rem; }
      .en { font-size: 2rem; }
      .plays { column-gap: 1.2rem; font-size: 1rem; }
    }
    /* Phone: figure and names side by side, the plays in two columns under them. */
    @media (max-width: 700px) {
      .row { --fig-h: 110px; column-gap: 1rem; }
      .nm { flex: 1 1 8rem; min-width: 0; }
      /* Under 24px the Greek takes the darker clay (AA for small text). */
      .gk { font-size: 1.15rem; color: var(--clay-text); }
      .en { font-size: 1.75rem; }
      .plays { flex: 1 1 100%; columns: 2; padding-top: .2rem; }
      /* Euphorbos reads heavy under the .4px phone hairline (John,
         2026-10-24: "slightly lighter weight" for mobile). */
      .row .fl[data-a="sophocles"] :global(.fig) { stroke-width: .2px; }
    }
  </style>
</body>
</html>
