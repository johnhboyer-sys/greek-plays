---
import SkipLink from '../components/SkipLink.astro';
import Search from '@shared/components/Search.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFoot from '../components/SiteFoot.astro';
import Pwa from '../components/Pwa.astro';
import { jsonLdSafe } from '../lib/jsonld';
import { SITE_NAME } from '../lib/site';
import { readFileSync } from 'node:fs';
import { WORKS } from '@shared/lib/works';
import '@shared/styles/global.css';
import '../styles/vase.css';
import '@shared/styles/vase-search.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The speech headings over the hits (the search port; Aristotle's chapter
// titles, ruling 17): a speech's title is its speaker's name, read from each
// play's chapter-titles.json when the page is built. A play without one gets
// the line the speech opens on alone.
type Titles = Record<string, Record<string, string>>;
const readTitles = (path: string): Titles => {
  try { return JSON.parse(readFileSync(`public/data/${path}`, 'utf-8')); } catch { return {}; }
};
const chapterTitles: Record<string, Titles> = {};
for (const w of WORKS) {
  const titles = readTitles(`${w.id}/chapter-titles.json`);
  if (Object.keys(titles).length) chapterTitles[w.id] = titles;
}

const siteName = SITE_NAME;

// DRAFT copy: John approves.
const pageTitle = `Search the Corpus in Greek and English — ${siteName}`;
const searchDescription =
  'Search the Greek plays across the original Greek and English' +
  ' translation — by word or phrase, in Greek script or Beta Code,' +
  ' with results cited by work.';
const canonical = Astro.site ? new URL(`${base}/search/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: searchDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: siteName },
  potentialAction: {
    '@type': 'SearchAction',
    target: canonical ? `${canonical}?q={search_term_string}` : undefined,
    'query-input': 'required name=search_term_string',
  },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={searchDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={searchDescription} />
  <meta property="og:site_name" content={siteName} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={searchDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
  <Pwa />
</head>
<body>
  <SkipLink />
  <h1 class="sr-only">Search</h1>
  <div class="wrap vase-search">
    <SiteHeader />
    <span id="main" tabindex="-1"></span>
    <Search client:load {chapterTitles} />
    <SiteFoot />
  </div>
</body>
</html>
