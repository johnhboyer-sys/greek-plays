---
// An author's page, served at the bare /<author> slug (docs/redesign/
// HANDOFF-ui-pass2-build.md §5, direction B): the name at the left and the
// figure at the right on its own ground line, the blurb under the name; then
// the plays in two columns, any group first.
import ThemeInit from '../../components/ThemeInit.astro';
import Pwa from '../../components/Pwa.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFoot from '../../components/SiteFoot.astro';
import Figure from '../../components/Figure.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { AUTHORS, getAuthor } from '@shared/lib/authors';
import { getWork, workLanding, type Work } from '@shared/lib/works';
import { SITE_NAME } from '../../lib/site';
import { jsonLdSafe } from '../../lib/jsonld';
import { isBuilt } from '../../lib/built-works';
import { authorDrawing } from '../../lib/drawings';
import { AUTHOR_GROUPS, ORDINALS } from '../../lib/author-groups';
import '@shared/styles/global.css';
import '../../styles/vase.css';

// Author pages only for authors with ≥1 built work. The registry may list
// works whose data isn't built in this checkout (see built-works.ts).
export function getStaticPaths() {
  return AUTHORS
    .filter((a) => a.works.some((id) => isBuilt(id)))
    .map((a) => ({ params: { author: a.id } }));
}

const authorId = Astro.params.author!;
const author = getAuthor(authorId)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteName = SITE_NAME;
// data-genre on <html>, as ReaderShell.astro sets it (header-chrome test);
// B keeps one accent, so nothing reads it on this page.
const genre = author.genre;

// Built works only, in the author's own curated order (author.works).
const works: Work[] = author.works
  .map((id) => getWork(id))
  .filter((w): w is Work => Boolean(w) && isBuilt(w.id));

// The group listed first (lib/author-groups.ts), when all its plays are
// built; the rest follow in the author's order (John, 2026-10-20: the
// Oresteia and Oedipus groups stay; "Titles only" and "Find a play" go).
const groupDef = AUTHOR_GROUPS[author.id];
const groupWorks = (groupDef?.works ?? [])
  .map((id) => works.find((w) => w.id === id))
  .filter((w): w is Work => Boolean(w));
const group = groupDef && groupWorks.length === groupDef.works.length
  ? {
      ...groupDef,
      works: groupWorks,
      note: groupDef.fromProduction && groupWorks[0].production
        ? `${groupDef.note} · ${groupWorks[0].production.replace(/^[^·]*play · /, '')}`
        : groupDef.note,
    }
  : null;
const rest = group ? works.filter((w) => !group.works.includes(w)) : works;

// authors.yaml blurbs may start in lower case (written to follow a name).
const blurb = author.blurb.charAt(0).toUpperCase() + author.blurb.slice(1);
const figure = authorDrawing(author.id);
// The figure's column sizes to the figure, never the figure to the column
// (§3.3): its width at the figure's own height. A figure too wide to stand
// beside the name on a phone (Aristophanes' Getty krater, 1.9 times as wide
// as it is tall) stands over it there instead, still at full height.
const ratio = figure ? figure.width / figure.height : 0.7;
const wide = ratio > 1.2;

// ── SEO ─────────────────────────────────────────────────────────────────────
const pageTitle = `${author.name} — Works in Greek & English`;
const metaDescription =
  `${author.name} (${author.floruit}): ${author.blurb} ${works.length} work${works.length === 1 ? '' : 's'}` +
  ` with the original Greek and English translation where available.`;
const canonical = Astro.site ? new URL(`${base}/${authorId}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  ...(author.nativeName ? { alternateName: author.nativeName } : {}),
  ...(canonical ? { url: canonical } : {}),
  description: author.blurb,
};
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: siteName,
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: author.name, item: canonical },
      ],
    }
  : null;
---
<html lang="en" data-genre={genre}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content={siteName} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body class="author-page" data-author={author.id}>
  <CommandPalette client:load />
  <div class="wrap">
    <SiteHeader stack />

    <main>
      <div class:list={['hero', { wide }]} style={`--r:${ratio.toFixed(3)}`}>
        <div class="lead"><Figure drawings={figure ? [figure] : []} /></div>
        <div class="hx">
          <p class="gk" lang="grc">{author.nativeName}</p>
          <h1 class="en" style={`--chars:${author.name.length}`}>{author.name}</h1>
          <p class="meta">{author.floruit} · {works.length} play{works.length === 1 ? '' : 's'}</p>
        </div>
        <p class="ab">{blurb}</p>
      </div>

      {group && (
        <section class="grp" aria-labelledby="grp-title">
          <h2 class="gl"><span class="gn" id="grp-title">{group.title}</span> <span class="gm">{group.note}</span></h2>
          <ol class="tri">
            {group.works.map((w, i) => (
              <li>
                {group.ordinals && <p class="ord">{ORDINALS[i]}</p>}
                <a class="t" href={`${base}${workLanding(w.id)}`}>{w.title}</a>
                {w.greekTitle && <span class="g" lang="grc">{w.greekTitle}</span>}
                {w.blurb && <p class="bl">{w.blurb}</p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      <ul class="list">
        {rest.map((w) => (
          <li>
            <a class="t" href={`${base}${workLanding(w.id)}`}>{w.title}</a>
            {w.greekTitle && <span class="g" lang="grc">{w.greekTitle}</span>}
            {w.blurb && <p class="bl">{w.blurb}</p>}
            {w.production && <p class="pr">{w.production}</p>}
          </li>
        ))}
      </ul>
    </main>

    <SiteFoot />
  </div>

  <style>
    /* The hero: a grid whose blurb is its own cell, so a phone can set it
       under the figure (John, 2026-10-20). */
    .hero {
      display: grid; grid-template-columns: 1fr max(24rem, calc(360px * var(--r)));
      grid-template-rows: 1fr auto;
      grid-template-areas: "hx lead" "ab lead";
      gap: 0 3rem; align-items: end; margin-top: 2.2rem;
    }
    .hero p { margin: 0; }
    .lead { grid-area: lead; --fig-h: 360px; --fig-lift: .5rem; }
    .hx { grid-area: hx; min-width: 0; }
    .gk { font: 400 2.2rem/1.1 var(--font-greek); color: var(--clay-deep); }
    .en { font: 400 5rem/1 var(--font-english); margin: .05rem 0 .5rem; }
    .meta { font: 400 1.1rem var(--font-ui); color: var(--mid); }
    .hero .ab { grid-area: ab; font: 400 1.35rem/1.45 var(--font-english); max-width: 30em; margin-top: .7rem; padding-bottom: 1rem; }

    .wrap a { color: inherit; text-decoration: none; }
    .wrap a:hover { text-decoration: underline; text-underline-offset: .12em; }
    .t { font: 400 1.7rem/1.15 var(--font-english); color: var(--ink); }
    /* Under 24px the Greek takes the darker clay (AA for small text). */
    .g { font: 400 1.2rem var(--font-greek); color: var(--clay-text); margin-left: .5em; }
    .bl { font: 400 1.12rem/1.45 var(--font-english); max-width: 34em; margin: .15rem 0 0; }
    .pr { font: 400 .92rem var(--font-ui); color: var(--mid); margin: .25rem 0 0; }

    /* The plays in two columns, none split across them. */
    .list, .tri { list-style: none; margin: 0; padding: 0; }
    .list { margin-top: 2.6rem; columns: 2; column-gap: 4rem; }
    .list li { break-inside: avoid; padding: .6rem 0 .9rem; }

    /* A group (the Oresteia, the Oedipus plays): its title and note, then
       its three plays side by side (DESIGN.md, Author pages). */
    .grp { margin-top: 2.6rem; }
    .gl { display: flex; align-items: baseline; gap: .3rem 1rem; flex-wrap: wrap; margin: 0; font-weight: 400; }
    .gn { font: 400 2.3rem/1.1 var(--font-english); }
    .gm { font: 400 1rem var(--font-ui); color: var(--mid); }
    .tri { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 4rem; margin-top: .8rem; }
    .tri li { padding: .6rem 0 .9rem; }
    .ord { font: 400 .95rem var(--font-ui); color: var(--mid); margin: 0 0 .15rem; }
    .grp + .list { margin-top: 1.6rem; }

    /* Phone: the name beside the figure, no taller than it, the blurb under
       both (John, 2026-10-20: "I don't like this extending ABOVE the image's
       height"); no ground line under the phone figure; one column. */
    @media (max-width: 700px) {
      .hero {
        --lead-w: max(8.5rem, calc(180px * var(--r)));
        grid-template-columns: 1fr var(--lead-w); grid-template-rows: auto auto;
        grid-template-areas: "hx lead" "ab ab"; gap: .2rem 1rem; margin-top: 1rem;
      }
      .hero.wide { --lead-w: 0px; grid-template-columns: 1fr; grid-template-areas: "lead" "hx" "ab"; gap: .8rem; }
      .lead { --fig-h: 180px; }
      .lead :global(.fb) { border-bottom: 0; }
      .gk { font-size: 1.4rem; color: var(--clay-text); }
      /* 3rem, or less where a long name would pass its column and run into
         the figure (Aristophanes); Cardo sets about .47em a letter. */
      .en { font-size: min(3rem, calc((100vw - 3rem - var(--lead-w)) / (var(--chars, 9) * .47))); }
      .hero .ab { font-size: 1.1rem; padding-bottom: 0; margin-top: .5rem; max-width: none; }
      .list { columns: 1; margin-top: 1.6rem; }
      .t { font-size: 1.45rem; }
      .g { font-size: 1.05rem; }
      .bl { font-size: 1.05rem; }
      .pr { display: none; }
      .grp { margin-top: 1.6rem; }
      .gn { font-size: 2rem; }
      .tri { grid-template-columns: 1fr; }
      .grp + .list { margin-top: 0; }
    }
  </style>
</body>
</html>
