---
// An author's page, served at the bare /<author> slug (docs/redesign/
// DESIGN.md, Author pages; sketch author-pages-round4.html): the author's
// tint as the page ground, the figure on its ground line, the names, dates,
// play count and blurb, then the plays without boxes, any group first.
import ThemeInit from '../../components/ThemeInit.astro';
import Pwa from '../../components/Pwa.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Figure from '../../components/Figure.astro';
import CommandPalette from '@shared/components/CommandPalette.svelte';
import { AUTHORS, getAuthor } from '@shared/lib/authors';
import { getWork, workLanding, type Work } from '@shared/lib/works';
import { SITE_NAME } from '../../lib/site';
import { jsonLdSafe } from '../../lib/jsonld';
import { isBuilt } from '../../lib/built-works';
import { AUTHOR_GROUPS, ORDINALS } from '../../lib/author-groups';
import '@shared/styles/global.css';

// The Greek editions list is part of the edition picker (plan 4.6), behind the flag.
const editionsOn = import.meta.env.PUBLIC_EDITIONS === '1';

// Author pages only for authors with ≥1 built work. The registry may list
// works whose data isn't built in this checkout (see built-works.ts).
export function getStaticPaths() {
  return AUTHORS
    .filter((a) => a.works.some((id) => isBuilt(id)))
    .map((a) => ({ params: { author: a.id } }));
}

const authorId = Astro.params.author!;
const author = getAuthor(authorId)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteName = SITE_NAME;
// data-genre on <html> picks the accent sitewide (rubric red for tragedy,
// malachite for comedy), as ReaderShell.astro sets it.
const genre = author.genre;

// Built works only, in the author's own curated order (author.works).
const works: Work[] = author.works
  .map((id) => getWork(id))
  .filter((w): w is Work => Boolean(w) && isBuilt(w.id));

// The group listed first (lib/author-groups.ts), when all its plays are
// built; the rest follow in the author's order.
const groupDef = AUTHOR_GROUPS[author.id];
const groupWorks = (groupDef?.works ?? [])
  .map((id) => works.find((w) => w.id === id))
  .filter((w): w is Work => Boolean(w));
const group = groupDef && groupWorks.length === groupDef.works.length
  ? {
      ...groupDef,
      works: groupWorks,
      note: groupDef.fromProduction && groupWorks[0].production
        ? `${groupDef.note} · ${groupWorks[0].production.replace(/^[^·]*play · /, '')}`
        : groupDef.note,
    }
  : null;
const rest = group ? works.filter((w) => !group.works.includes(w)) : works;

// authors.yaml blurbs may start in lower case (written to follow a name).
const blurb = author.blurb.charAt(0).toUpperCase() + author.blurb.slice(1);
const findOn = author.id === 'euripides';

// ── SEO ─────────────────────────────────────────────────────────────────────
const pageTitle = `${author.name} — Works in Greek & English`;
const metaDescription =
  `${author.name} (${author.floruit}): ${author.blurb} ${works.length} work${works.length === 1 ? '' : 's'}` +
  ` with the original Greek and English translation where available.`;
const canonical = Astro.site ? new URL(`${base}/${authorId}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  ...(author.nativeName ? { alternateName: author.nativeName } : {}),
  ...(canonical ? { url: canonical } : {}),
  description: author.blurb,
};
const breadcrumbLd = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: siteName,
          item: new URL(`${base}/`, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: author.name, item: canonical },
      ],
    }
  : null;
---
<html lang="en" data-genre={genre}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content={siteName} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  {breadcrumbLd && <script type="application/ld+json" set:html={jsonLdSafe(breadcrumbLd)} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body class="author-page" data-author={author.id}>
  <CommandPalette client:load />
  <div class="ap">
    <SiteHeader />

    <main>
      <div class="hero">
        <Figure slug={author.id} />
        <div class="hx">
          <p class="gk" lang="grc">{author.nativeName}</p>
          <h1 class="en">{author.name}</h1>
          <p class="meta">{author.floruit} · {works.length} play{works.length === 1 ? '' : 's'}</p>
          <p class="ab">{blurb}</p>
        </div>
      </div>

      <div class="ctl">
        {findOn && (
          <label class="find">
            <span>Find a play</span>
            <input type="search" id="find-play" placeholder="Title in English or Greek" autocomplete="off" />
          </label>
        )}
        <div class="vw" role="group" aria-label="List view">
          <button type="button" data-view="notes" aria-pressed="true">Titles and notes</button>
          <button type="button" data-view="titles" aria-pressed="false">Titles only</button>
        </div>
      </div>

      <ul class="pl" id="play-list">
        {group && (
          <li class="grp">
            <h2 class="gl"><span class="gn">{group.title}</span> <span class="gm">{group.note}</span></h2>
            <ol class="tri">
              {group.works.map((w, i) => (
                <li class="play" data-find={`${w.title} ${w.greekTitle ?? ''}`}>
                  {group.ordinals && <div class="ord">{ORDINALS[i]}</div>}
                  <a href={`${base}${workLanding(w.id)}`} class="t">{w.title}</a>
                  {w.greekTitle && <span class="g" lang="grc">{w.greekTitle}</span>}
                  {w.blurb && <p class="bl">{w.blurb}</p>}
                </li>
              ))}
            </ol>
          </li>
        )}
        {rest.map((w) => (
          <li class="it play" data-find={`${w.title} ${w.greekTitle ?? ''}`}>
            <div class="tt">
              <a href={`${base}${workLanding(w.id)}`} class="t">{w.title}</a>
              {w.greekTitle && <span class="g" lang="grc">{w.greekTitle}</span>}
            </div>
            <div class="nt">
              {w.blurb && <p class="bl">{w.blurb}</p>}
              {w.production && <p class="pr">{w.production}</p>}
            </div>
          </li>
        ))}
      </ul>
      {findOn && <p class="none" id="find-none" hidden>No play matches.</p>}

      {editionsOn && works.some((w) => (w.greekEditions?.length ?? 0) > 1) && (
        <section class="eds">
          <h2>Greek editions</h2>
          <ul>
            {works.filter((w) => (w.greekEditions?.length ?? 0) > 1).map((w) => (
              <li>
                {w.title}:{' '}
                {w.greekEditions!.map((e, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`${base}${workLanding(w.id)}?view=greek&ed=${encodeURIComponent(e.id)}`}>{e.short}</a>
                  </>
                ))}
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>

    <footer class="foot">
      <nav aria-label="Resources">
        <a href={`${base}/`}>All playwrights</a>
        <a href={`${base}/search`}>Search the plays</a>
        <a href={`${base}/lemma/grc/`}>Greek lexicon</a>
        <a href={`${base}/attribution`}>Texts and licences</a>
        <a href={`${base}/support`}>Support</a>
      </nav>
    </footer>
  </div>

  <style>
    /* The author's tint (DESIGN.md, Author tints); dark values pass AA. */
    body.author-page {
      --ink: #1b1c1f;
      --ink-mid: #5c6064;
      background: var(--tint); color: var(--ink);
      font-family: "Alegreya Sans", system-ui, sans-serif;
    }
    body[data-author="aeschylus"]    { --tint: #e2e7ec; --link: #34536b; }
    body[data-author="sophocles"]    { --tint: #e3e8df; --link: #43603b; }
    body[data-author="euripides"]    { --tint: #efe2dc; --link: #8a3f30; }
    body[data-author="aristophanes"] { --tint: #f0e7d2; --link: #6e5114; }
    :root[data-theme="dark"] body.author-page { --ink: #e8e1d3; --ink-mid: #b9b0a1; }
    :root[data-theme="dark"] body[data-author="aeschylus"]    { --tint: #182027; --link: #9db8cf; }
    :root[data-theme="dark"] body[data-author="sophocles"]    { --tint: #1a2019; --link: #a9c39e; }
    :root[data-theme="dark"] body[data-author="euripides"]    { --tint: #261b17; --link: #e3a493; }
    :root[data-theme="dark"] body[data-author="aristophanes"] { --tint: #252013; --link: #d9bb7c; }

    .ap { max-width: 80rem; margin: 0 auto; padding: 0 3.5rem 3.5rem; }
    .ap a { color: inherit; text-decoration: none; }
    .ap a:hover { text-decoration: underline; }

    .hero {
      --fig-h: 20rem;
      display: grid; grid-template-columns: 18.75rem 1fr; gap: 3rem;
      align-items: end; margin: 1.1rem 0 2.6rem;
    }
    .hero p { margin: 0; }
    .gk { font-family: var(--font-greek); font-size: 1.9rem; line-height: 1.1; color: var(--ink-mid); }
    .en { font: 400 4.75rem/1 Cardo, serif; margin: .1rem 0 .6rem; color: var(--link); }
    .meta { font-size: 1.12rem; color: var(--ink-mid); }
    .hero .ab { font: 400 1.3rem/1.4 Cardo, serif; margin-top: .75rem; max-width: 34em; }

    .ctl { display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; margin-bottom: .5rem; }
    .vw { display: flex; gap: 1.1rem; margin-left: auto; }
    .vw button {
      background: none; border: 0; padding: 0; cursor: pointer;
      font: inherit; font-size: 1rem; color: var(--ink-mid);
    }
    .vw button[aria-pressed="true"] { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
    .find { display: flex; align-items: center; gap: .6rem; font-size: 1rem; }
    .find input {
      font: 1rem "Alegreya Sans", sans-serif; padding: .45rem .6rem; width: 16rem;
      color: var(--ink); background: color-mix(in srgb, var(--tint) 50%, white);
      border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent); border-radius: 2px;
    }
    :root[data-theme="dark"] .find input { background: color-mix(in srgb, var(--tint) 70%, black); }

    .pl, .tri { list-style: none; margin: 0; padding: 0; }
    .it { display: grid; grid-template-columns: 25rem 1fr; gap: 2.5rem; padding: 1.25rem 0; }
    .ap .t { display: block; font: 400 1.9rem/1.15 Cardo, serif; color: var(--link); }
    .g { display: block; font: 400 1.25rem/1.3 var(--font-greek); color: var(--ink-mid); margin-top: .1rem; }
    .bl { font: 400 1.19rem/1.45 Cardo, serif; margin: .25rem 0 0; max-width: 36em; }
    .pr { font-size: .94rem; color: var(--ink-mid); margin: .4rem 0 0; }

    .grp { margin: .9rem 0 1.6rem; }
    .gl { display: flex; align-items: baseline; gap: 1.1rem; flex-wrap: wrap; margin: 0; font-weight: 400; }
    .gn { font: 400 2.5rem Cardo, serif; }
    .gm { color: var(--ink-mid); font-size: 1rem; font-family: "Alegreya Sans", sans-serif; }
    .tri { margin-top: 1.1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
    .ord { font-size: .94rem; color: var(--ink-mid); margin-bottom: .25rem; }

    /* Titles only: the blurbs and notes go. */
    .pl[data-view="titles"] .bl, .pl[data-view="titles"] .pr, .pl[data-view="titles"] .gm { display: none; }
    .pl[data-view="titles"] .it { padding: .6rem 0; }
    .play[hidden], .grp[hidden] { display: none; }
    .none { color: var(--ink-mid); }

    .eds { margin-top: 2.5rem; }
    .eds h2 { font: 400 1.6rem Cardo, serif; margin: 0 0 .5rem; }
    .eds ul { margin: 0; padding: 0; list-style: none; }
    .eds a { color: var(--link); }

    .foot { margin-top: 4rem; display: flex; justify-content: center; color: var(--ink-mid); }
    .foot nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.6rem; }
    .foot a { color: var(--ink-mid); }

    /* Phone: hero stacked; each play its title, Greek title and blurb only. */
    @media (max-width: 40rem) {
      .ap { padding: 0 1rem 2rem; }
      .hero { --fig-h: 11.9rem; grid-template-columns: 1fr; gap: .9rem; margin: .6rem 0 1.5rem; }
      .gk { font-size: 1.3rem; }
      .en { font-size: 2.9rem; }
      .hero .ab { font-size: 1.12rem; }
      .ctl { flex-direction: column; align-items: stretch; gap: .6rem; }
      .vw { margin-left: 0; }
      .find { flex-direction: column; align-items: stretch; gap: .25rem; }
      .find input { width: 100%; }
      .it { grid-template-columns: 1fr; gap: .25rem; padding: 1rem 0; }
      .ap .t { font-size: 1.62rem; }
      .bl { font-size: 1.06rem; }
      .pr { display: none; }
      .gl { display: block; }
      .gn { display: block; font-size: 2rem; }
      .gm { display: block; margin-top: .25rem; }
      body[data-author="aeschylus"] .gm { display: none; }
      .tri { grid-template-columns: 1fr; gap: 1.25rem; }
      .foot { margin-top: 2.5rem; }
    }
    @media (min-width: 40.01rem) and (max-width: 64rem) {
      .it { grid-template-columns: 16rem 1fr; gap: 1.5rem; }
      .en { font-size: 3.6rem; }
    }
  </style>

  <script>
    // "Titles and notes / Titles only", remembered across author pages; and
    // Find a play (Euripides), matching English or Greek titles with accents
    // and case ignored.
    const KEY = 'drama-author-view';
    const list = document.getElementById('play-list');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.vw button');
    const setView = (view: string) => {
      if (!list) return;
      list.dataset.view = view;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    };
    try { const saved = localStorage.getItem(KEY); if (saved) setView(saved); } catch {}
    buttons.forEach((b) => b.addEventListener('click', () => {
      setView(b.dataset.view!);
      try { localStorage.setItem(KEY, b.dataset.view!); } catch {}
    }));

    const fold = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
    const find = document.getElementById('find-play') as HTMLInputElement | null;
    find?.addEventListener('input', () => {
      const q = fold(find.value.trim());
      let shown = 0;
      document.querySelectorAll<HTMLElement>('.play').forEach((li) => {
        const hit = !q || fold(li.dataset.find ?? '').includes(q);
        li.hidden = !hit;
        if (hit) shown++;
      });
      document.querySelectorAll<HTMLElement>('.grp').forEach((g) => {
        g.hidden = !g.querySelector('.play:not([hidden])');
      });
      document.getElementById('find-none')!.hidden = shown > 0;
    });
  </script>
</body>
</html>
