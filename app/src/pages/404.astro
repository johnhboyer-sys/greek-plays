---
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFoot from '../components/SiteFoot.astro';
import Pwa from '../components/Pwa.astro';
import { jsonLdSafe } from '../lib/jsonld';
import { SITE_NAME } from '../lib/site';
import '@shared/styles/global.css';
import '../styles/vase.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const siteName = SITE_NAME;
const pageTitle = `Page Not Found — ${siteName}`;
const metaDescription =
  'The requested page could not be found. Return to the corpus or search its Greek and English texts.';
const canonical = Astro.site ? new URL(`${base}/404/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: siteName },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="noindex,follow" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content={siteName} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body>
  <div class="wrap"><SiteHeader /></div>
  <main class="not-found">
    {/* John, 2026-10-21 ("custom 404 pages with a funny message"; "all 7
        are good. Use all 7"): a cry from the plays and a joke, one of seven
        at random. */}
    <p class="cry" lang="grc" data-nf="cry">ἰοὺ ἰού.</p>
    <h1 class="line" data-nf="line">This page died offstage. In Greek tragedy that’s where all the bad things happen.</h1>
    <p class="go"><a href={`${base}/`}>Back to the plays</a><a href={`${base}/search`}>Search</a></p>
  </main>
  <script is:inline>
    (function () {
      var lines = [
        ['ἰοὺ ἰού.', 'This page died offstage. In Greek tragedy that’s where all the bad things happen.'],
        ['ὀτοτοτοτοῖ.', 'The page you wanted isn’t here. A messenger will be along shortly to describe what happened to it, in sixty lines of vivid detail.'],
        ['φεῦ.', 'Sophocles wrote 123 plays and we have seven. Against those odds, losing one web page is a small thing.'],
        ['οἴμοι.', 'This page was left on a hillside as an infant. It may turn up in twenty years and cause a great deal of trouble.'],
        ['αἰαῖ.', 'The chorus has been told about this page and will now sing about it at length.'],
        ['ὦ Ζεῦ.', 'No page. Normally a god would come down on a crane at this point and fix everything. The crane is broken.'],
        ['παπαῖ.', 'Aristophanes would have a joke for this, but it’s obscene and wouldn’t survive translation.'],
      ];
      var l = lines[Math.floor(Math.random() * lines.length)];
      document.querySelector('[data-nf="cry"]').textContent = l[0];
      document.querySelector('[data-nf="line"]').textContent = l[1];
    })();
  </script>

  <style>
    body { background: var(--paper); color: var(--ink); margin: 0; }
    .not-found {
      max-width: 34rem; margin: 0 auto;
      padding: clamp(3.5rem, 12vh, 8rem) 1.5rem 4rem;
      text-align: center;
    }
    .cry { font: 400 clamp(2.2rem, 7vw, 3.4rem)/1.15 var(--font-greek); color: var(--clay-deep); margin: 0 0 1.2rem; }
    .line { font: 400 1.35rem/1.45 var(--font-english); color: var(--ink); margin: 0 0 .6rem; text-wrap: balance; }
    .go { display: flex; gap: 1.6rem; justify-content: center; margin: 2.4rem 0 0; font: 400 1rem var(--font-ui); }
    .go a { color: var(--clay-text); text-decoration: none; }
    .go a:hover { text-decoration: underline; text-underline-offset: .15em; }
  </style>
  <div class="wrap"><SiteFoot /></div>
</body>
</html>
