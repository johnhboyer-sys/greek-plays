---
import SkipLink from '../../components/SkipLink.astro';
// How to search (docs/redesign/HANDOFF-ui-pass2-build.md §8.2 step 1: "the
// chart inside Search.svelte becomes the 'How to search' page, with the
// controls explained"). The Beta Code chart is the search's old "How to type
// Greek" help; the control notes reuse that form's own tooltips where it had
// them. DRAFT copy: John approves.
import ThemeInit from '../../components/ThemeInit.astro';
import Pwa from '../../components/Pwa.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFoot from '../../components/SiteFoot.astro';
import { BETA_LETTERS, BETA_MARKS, BETA_EXAMPLES } from '@shared/lib/beta-chart';
import { SITE_NAME } from '../../lib/site';
import '@shared/styles/global.css';
import '../../styles/vase.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = `How to search — ${SITE_NAME}`;
const canonical = Astro.site ? new URL(`${base}/search/how/`, Astro.site).href : undefined;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content="How the search's boxes and controls work, and how to type Greek in Beta Code." />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <Pwa />
</head>
<body>
  <SkipLink />
  <div class="wrap">
    <SiteHeader />
    <main class="how" id="main" tabindex="-1">
      <h1>How to search</h1>
      <p class="lede">Type Greek, English, or both, and press Search. <a href={`${base}/search`}>Back to the search</a></p>

      <h2>The controls</h2>
      <dl>
        <dt>Words</dt>
        <dd>“All words” finds lines with every word you typed. “Any of them” finds lines with at least one. “Exact phrase” finds the words together, in the order typed. The Greek and the English each have this setting.</dd>
        <dt>Forms</dt>
        <dd>“Any form of the word” matches every inflected form of the word’s headword. “Only as typed” matches the word as written. In English, “Any form of the word” also matches plurals and possessives.</dd>
        <dt>Accents</dt>
        <dd>“Accents ignored” treats λόγος and λογός as the same word. “Accents matter” treats them as different words; a word typed without accents then matches only unaccented words.</dd>
        <dt>Greek text</dt>
        <dd>“Each play’s main text” searches the Greek text each play opens with. Choosing an edition searches that edition, in Greek-only searches, in the plays that have it.</dd>
        <dt>Wildcard</dt>
        <dd>Use <code>*</code> for a wildcard: <code>fron*</code> matches φρόνησις, φρόνιμος, etc.</dd>
        <dt>Lemma search</dt>
        <dd>With “Any form of the word”, lists the dictionary headwords your word can come from. Untick a headword to leave its forms out. Example: <span lang="grc">πόλεις</span> can come from <span lang="grc">πόλις</span>, <span lang="grc">πολύς</span> or <span lang="grc">πολέω</span>.</dd>
        <dt>Near</dt>
        <dd>Under “Advanced search ›”. Limit results to places where a Greek word occurs near a second term. The second term can be an “exact word”, a “lemma” (any form of the word; tick the headwords to include), or a “word form”: any word with a particular grammatical form (e.g., feminine dative plural). Choose whether the second term is “before”, “after”, or “on either side of” the first word, and how far away it should be (a number of “words” or “lines”; 0 lines is the same line). The “add a term” link adds up to two more terms, each placed against the first word. With more than one term, “In this order” keeps the terms in the order given. Each term must match a different word.</dd>
        <dt>Form</dt>
        <dd>With “word form”, sets the grammar of the term. Choose “a verb form”, “a noun or adjective form”, or “a word class”, then the categories, for example “aorist” and “optative”. A category left at “any” is not checked.</dd>
        <dt>English near</dt>
        <dd>Under “Advanced search ›”. Finds the English you typed with a second English word close by, in the same translation. Choose “before”, “after”, or “on either side of”, and a number of words.</dd>
        <dt>Together</dt>
        <dd>With both boxes filled: “Lines where both the Greek and the English match”, or “Lines where the Greek or the English matches”.</dd>
        <dt>In</dt>
        <dd>“All 44 plays”, one author’s plays, or the plays you tick under “choose plays”.</dd>
      </dl>

      <h2 id="share">Sharing a search</h2>
      <p>The page address holds the whole search. Copy it to share or bookmark the search.</p>

      <h2 id="phrases">The phrase index</h2>
      <p>Lists every phrase of two to five words that occurs at least twice in the plays. <a href={`${base}/search/phrases`}>Open the phrase index</a></p>
      <dl>
        <dt>Count</dt>
        <dd>“Greek, as written” keeps <span lang="grc">ὦ τέκνον</span> and <span lang="grc">ὦ τέκνα</span> apart. “Greek, any form” counts them together. “English (main translation)” lists phrases in each play’s main translation. Type the words as printed.</dd>
        <dt>Length and At least</dt>
        <dd>“2 words” to “5 words” sets the phrase lengths shown. “At least” sets how many times a phrase must occur.</dd>
        <dt>Order</dt>
        <dd>“Most distinctive first” puts first the phrases whose words occur together more often than chance predicts. “Commonest first”, “Shortest first”, and “Alphabetical” sort as they say.</dd>
        <dt>Hide phrases made only of common words</dt>
        <dd>In English, hides phrases such as “of the” and “it is”.</dd>
        <dt>Lines</dt>
        <dd>Click a phrase to list its lines by play. Click a line number to open it in the reader.</dd>
      </dl>

      <h2>How to type Greek</h2>
      <p>The Greek box takes Greek letters or Beta Code, Greek typed in Latin letters. Turn on β Beta Code to see Greek as you type; Shift gives a capital. One key for each letter:</p>
      <ul class="letters">
        {BETA_LETTERS.map((L) => (
          <li><code>{L.beta}</code><span class="gk" lang="grc">{L.greek}</span><span class="nm">{L.name}</span></li>
        ))}
      </ul>
      <h3>Accents and breathings (optional)</h3>
      <p>Type the mark after the vowel:</p>
      <ul class="marks">
        {BETA_MARKS.map((M) => (
          <li><code>{M.beta}</code><span class="gk" lang="grc">{M.example}</span><span class="nm">{M.name}</span></li>
        ))}
      </ul>
      <h3>Examples</h3>
      <ul class="marks">
        {BETA_EXAMPLES.map((E) => (
          <li><code>{E.beta}</code><span class="gk" lang="grc">{E.greek}</span></li>
        ))}
      </ul>
      <p><code>h</code> is η and <code>w</code> is ω; <code>e</code> and <code>o</code> are ε and ο.</p>
    </main>
    <SiteFoot />
  </div>

  <style>
    .how { max-width: 44rem; margin-top: 2rem; font: 400 1.1rem/1.5 var(--font-english); }
    .how h1 { font: 400 2.6rem/1.1 var(--font-english); margin: 0; }
    .how h2 { font: 400 1.6rem/1.2 var(--font-english); margin: 2.2rem 0 .6rem; }
    .how h3 { font: 400 1rem var(--font-ui); color: var(--mid); margin: 1.6rem 0 .4rem; }
    .how p { margin: .4rem 0; }
    .how .lede { color: var(--ink); }
    .how .lede a { font: 400 1rem var(--font-ui); color: var(--mid); margin-left: .6rem; }
    .how p a { color: var(--mid); text-decoration: underline; text-underline-offset: 4px; font-family: var(--font-ui); font-size: 1rem; }
    .how dt { font: 400 1rem var(--font-ui); color: var(--ink); margin-top: .9rem; }
    .how dd { margin: .1rem 0 0; }
    .how [lang="grc"] { font-family: var(--font-greek); }
    .how code { font: 400 .95rem ui-monospace, Menlo, monospace; }
    .how ul { list-style: none; margin: .4rem 0; padding: 0; }
    .how .letters { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: .2rem 1.5rem; }
    .how li { display: flex; gap: .6rem; align-items: baseline; padding: .1rem 0; }
    .how li code { min-width: 1.4rem; color: var(--clay-text); }
    .how .gk { font-family: var(--font-greek); }
    .how .nm { font: 400 .9rem var(--font-ui); color: var(--mid); }
    @media (max-width: 700px) { .how h1 { font-size: 2.1rem; } }
  </style>
</body>
</html>
