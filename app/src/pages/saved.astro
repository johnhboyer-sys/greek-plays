---
// The searches kept in this browser by Save search on the results (ported
// with the search page from aristotle-reader's saved.astro, in this site's
// frame and the Vase's tokens). The list itself is SavedSearches.svelte; its
// styles are the block below, under .saved.
import SkipLink from '../components/SkipLink.astro';
import SavedSearches from '@shared/components/SavedSearches.svelte';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFoot from '../components/SiteFoot.astro';
import Pwa from '../components/Pwa.astro';
import { SITE_NAME } from '../lib/site';
import '@shared/styles/global.css';
import '../styles/vase.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{`Saved searches — ${SITE_NAME}`}</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
  <Pwa />
</head>
<body>
  <SkipLink />
  <div class="wrap">
    <SiteHeader />
    <main id="main" class="saved" tabindex="-1">
      <h1>Saved searches</h1>
      <SavedSearches client:load />
    </main>
    <SiteFoot />
  </div>
</body>
</html>

<style is:global>
  /* The Vase's tokens only (vase.css): Cardo for the title and the names,
     Alegreya Sans for the controls, the clay under a link. */
  .saved { max-width: 760px; padding: 2rem 0 4.5rem; font-family: var(--font-ui); color: var(--ink); }
  .saved h1 { margin: 0 0 18px; font: 400 2.5rem/1.1 var(--font-english); color: var(--ink); }
  .saved .sv-label { margin: 0; font: 500 16px/1.4 var(--font-ui); color: var(--mid); }
  .saved .sv-tools { display: flex; flex-wrap: wrap; gap: 0 28px; margin-top: 10px; }
  .saved .sv-status { margin: 6px 0 0; font: 500 16px/1.4 var(--font-ui); color: var(--ink); }
  .saved .sv-status:empty { margin: 0; }
  .saved .sv-empty { margin: 18px 0 0; font: 400 18px/1.5 var(--font-english); color: var(--mid); }
  .saved .sv-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: 500 16px/1.2 var(--font-ui);
    color: var(--ink);
    text-decoration: underline 2px var(--clay-text);
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .saved .sv-btn:hover:not(:disabled) { color: var(--clay-text); }
  .saved .sv-btn:disabled { color: var(--mid); text-decoration-color: var(--hair); cursor: default; }
  .saved .sv-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .saved .sv-list { margin: 18px 0 0; padding: 0; list-style: none; }
  .saved .sv-item { padding: 20px 0 10px; }
  .saved .sv-name { margin: 0; font: 400 24px/1.3 var(--font-english); color: var(--ink); overflow-wrap: anywhere; }
  .saved .sv-date { margin: 6px 0 0; font: 500 14px/1.3 var(--font-ui); color: var(--mid); }
  .saved .sv-note { margin: 10px 0 0; font: 400 18px/1.55 var(--font-english); color: var(--ink); white-space: pre-wrap; }
  .saved .sv-actions { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 6px; }
  .saved .sv-edit { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 4px; }
  .saved .sv-input {
    flex: 1 1 100%;
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    font: 400 18px/1.4 var(--font-english);
    color: var(--ink);
  }
  .saved .sv-input:focus-visible { outline: none; border-bottom: 2px solid var(--clay-text); }
  .saved .sv-item > .sv-input { margin-top: 10px; }
</style>
