---
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFoot from '../components/SiteFoot.astro';
import Pwa from '../components/Pwa.astro';
import '@shared/styles/global.css';
import { WORKS, visibleTranslations, type Work, type TranslationRef } from '@shared/lib/works';
import { jsonLdSafe } from '../lib/jsonld';
import { SITE_NAME } from '../lib/site';
import { servedDrawings } from '../lib/drawings';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const siteName = SITE_NAME;
const editionsOn = import.meta.env.PUBLIC_EDITIONS === '1';

// Texts & Licences, play by play (John, 2026-10-23): for each play the Greek
// editions and the English translations as bibliography, and every licence
// in one section at the end. DRAFT copy: John approves.

// The reference Greek text: the registry's short form, written out in full.
function greekFull(short: string): string {
  const v = (s: string) => s.match(/vol\. (\d+)/)?.[1];
  const y = (s: string) => s.match(/(\d{4})\)$/)?.[1];
  if (short.startsWith('Murray, Aeschyli')) return 'Gilbert Murray, ed., Aeschyli septem quae supersunt tragoediae, 2nd ed. (Oxford: Clarendon Press, 1955)';
  if (short.startsWith('Dain & Mazon')) return `Alphonse Dain and Paul Mazon, eds., Sophocle, vol. ${v(short)} (Paris: Les Belles Lettres, ${y(short)})`;
  if (short.startsWith('Diggle')) return `James Diggle, ed., Euripidis fabulae, vol. ${v(short)} (Oxford: Clarendon Press, ${y(short)})`;
  if (short.startsWith('Coulon & van Daele')) return `Victor Coulon and Hilaire van Daele, eds., Aristophane, vol. ${v(short)} (Paris: Les Belles Lettres, ${y(short)})`;
  if (short.startsWith('Dover')) return 'K. J. Dover, ed., Aristophanes: Clouds (Oxford: Clarendon Press, 1968)';
  if (short.startsWith('MacDowell')) return 'D. M. MacDowell, ed., Aristophanes: Wasps (Oxford: Clarendon Press, 1971)';
  if (short.startsWith('Ussher')) return 'R. G. Ussher, ed., Aristophanes: Ecclesiazusae (Oxford: Clarendon Press, 1973)';
  throw new Error(`attribution: no full citation for the Greek text "${short}"`);
}

const MURRAY: Record<string, string> = {
  hippolytus: 'The Hippolytus of Euripides (London: George Allen, 1902)',
  bacchae: 'The Bacchae of Euripides (London: George Allen, 1902)',
  'electra-eur': 'The Electra of Euripides (London: George Allen, 1905)',
  'trojan-women': 'The Trojan Women of Euripides (London: George Allen, 1905)',
  medea: 'The Medea of Euripides (London: George Allen, 1906)',
  frogs: 'The Frogs of Aristophanes (London: George Allen, 1908)',
  'iphigenia-in-tauris': 'The Iphigenia in Tauris of Euripides (London: George Allen, 1910)',
  'oedipus-tyrannus': 'Oedipus, King of Thebes (London: George Allen, 1911)',
  rhesus: 'The Rhesus of Euripides (London: George Allen, 1913)',
  alcestis: 'The Alcestis of Euripides (London: George Allen, 1915)',
  agamemnon: 'The Agamemnon of Aeschylus (London: George Allen & Unwin, 1920)',
};
const KOSMOS: Record<string, [string, string]> = {
  'seven-against-thebes': ['Herbert Weir Smyth, rev. the Seven Against Thebes Heroization team (Hélène Emeriaud, Kelly Lambert, Janet M. Ozsolak, Sarah Scott, Keith Stone)', 'https://kosmossociety.org/seven-against-thebes-aeschylus/'],
  agamemnon: ['Herbert Weir Smyth, rev. Gregory Crane and Graeme Bird, further rev. Gregory Nagy', 'https://kosmossociety.org/agamemnon-aeschylus/'],
  'libation-bearers': ['Jim Erdman, further rev. Gregory Nagy', 'https://kosmossociety.org/libation-bearers-aeschylus/'],
  eumenides: ['Herbert Weir Smyth, rev. Cynthia Bannon, further rev. Gregory Nagy', 'https://kosmossociety.org/eumenides-aeschylus/'],
  antigone: ['R. C. Jebb, rev. Pierre Habel and Gregory Nagy, newly rev. the Hour 25 Antigone Team (Brian Prescott-Decie, Jacqui Donlon, Jessica Eichelburg, Claudia Filos, Sarah Scott)', 'https://kosmossociety.org/antigone-sophocles-2/'],
  'oedipus-coloneus': ['R. C. Jebb, rev. Roger Ceragioli, further rev. Gregory Nagy', 'https://kosmossociety.org/sophocles-oedipus-at-colonus/'],
  'oedipus-tyrannus': ['R. C. Jebb, rev. Alex Sens, further rev. Gregory Nagy', 'https://kosmossociety.org/oedipus-tyrannus-sophocles/'],
  helen: ['E. P. Coleridge, rev. the Helen Heroization team (Hélène Emeriaud, Claudia Filos, Janet M. Ozsolak, Sarah Scott, Jack Vaughan)', 'https://kosmossociety.org/euripides-helen/'],
  heracles: ['Robert Potter, adapted by Mary Ebbott and Casey Dué, further adapted by Miriam Kamil', 'https://chs.harvard.edu/primary-source/euripides-herakles'],
  medea: ['E. P. Coleridge, rev. Roger Ceragioli, further rev. Gregory Nagy, newly rev. the Hour 25 Medea Heroization Team (Jessica Eichelburg, Hélène Emeriaud, Claudia Filos, Janet M. Ozsolak, Sarah Scott, Jack Vaughan)', 'https://kosmossociety.org/euripides-medea/'],
  'trojan-women': ['E. P. Coleridge, rev. the Trojan Women Heroization team (Keith DeStone, Hélène Emeriaud, Kelly Lambert, Janet M. Ozsolak, Sarah Scott)', 'https://kosmossociety.org/trojan-women-euripides/'],
  bacchae: ['T. A. Buckley, rev. Alex Sens, further rev. Gregory Nagy', 'https://kosmossociety.org/bacchae-euripides/'],
  hippolytus: ['E. P. Coleridge, rev. Mary Jane Rein, further rev. Gregory Nagy', 'https://kosmossociety.org/hippolytus-euripides/'],
};
const ARROWSMITH: Record<string, [string, string]> = {
  birds: ['1961', 'https://doi.org/10.3998/mpub.12945782'],
  clouds: ['1962', 'https://doi.org/10.3998/mpub.12945776'],
};
const ATREUS = new Set(['agamemnon', 'libation-bearers', 'eumenides']);

type Cite = { text: string; href?: string };
// The English: one bibliographic line per translation. A translation printed
// in the same book as one of the play's Greek editions (Smyth's and Storr's
// Loebs, Jebb's commentaries, Way's Medea) cites that book.
function englishCite(w: Work, t: TranslationRef): Cite {
  const ed = (id: string) => w.greekEditions?.find((e) => e.id === id)?.full;
  switch (t.id) {
    case 'smyth': return { text: ed('smyth-loeb') ?? 'H. W. Smyth, Aeschylus, 2 vols. (Loeb Classical Library, 1922–26)' };
    case 'storr': return { text: ed('storr-loeb') ?? 'F. Storr, Sophocles, 2 vols. (Loeb Classical Library, 1912–13)' };
    case 'jebb': return { text: ed('jebb') ?? 'R. C. Jebb, Sophocles: The Plays and Fragments (Cambridge, 1883–1900)' };
    case 'way': return { text: ed('way-loeb') ?? 'A. S. Way, Euripides, 4 vols. (Loeb Classical Library, London: Heinemann; New York: Macmillan, 1912)' };
    case 'coleridge': return { text: 'E. P. Coleridge, The Plays of Euripides, 2 vols. (London: George Bell and Sons, 1891)' };
    case 'buckley': return { text: 'T. A. Buckley, The Tragedies of Euripides (London: Henry G. Bohn, 1850)' };
    case 'morshead': return ATREUS.has(w.id)
      ? { text: 'E. D. A. Morshead, The House of Atreus: Being the Agamemnon, Libation-Bearers, and Furies of Aeschylus (London, 1881)', href: 'https://en.wikisource.org/wiki/The_House_of_Atreus' }
      : { text: 'E. D. A. Morshead, Four Plays of Aeschylus (1908)', href: 'https://en.wikisource.org/wiki/Four_Plays_of_Aeschylus_(1908)_Morshead' };
    case 'murray-verse': { const m = MURRAY[w.id]; if (m) return { text: `Gilbert Murray, ${m}` }; break; }
    case 'kosmos': { const k = KOSMOS[w.id]; if (k) return { text: `${k[0]}, in the Kosmos Society Sourcebook, ed. Gregory Nagy (Center for Hellenic Studies)`, href: k[1] }; break; }
    case 'johnston': return { text: `Ian Johnston, ${w.title} (Vancouver Island University)`, href: 'https://web.viu.ca/johnstoi/' };
    case 'athenian-society': return { text: 'Aristophanes: The Eleven Comedies, 2 vols. (London: The Athenian Society, 1912)' };
    case 'hickie': return { text: 'W. J. Hickie, The Comedies of Aristophanes, 2 vols. (London: Henry G. Bohn, 1853)' };
    case 'rogers': return { text: 'B. B. Rogers, Aristophanes, 3 vols. (Loeb Classical Library, London: Heinemann; New York: G. P. Putnam’s Sons, 1924)' };
    case 'lindsay': return { text: 'Jack Lindsay, Lysistrata (Fanfrolico Press, 1925)' };
    case 'arrowsmith': { const a = ARROWSMITH[w.id]; if (a) return { text: `William Arrowsmith, ${w.title}, in The Complete Greek Comedy (Ann Arbor: University of Michigan Press, ${a[0]})`, href: a[1] }; break; }
  }
  throw new Error(`attribution: no citation for translation "${t.id}" on ${w.id}`);
}

const plays = WORKS.map((w) => {
  const greek = [greekFull(w.greekSource.full)];
  if (editionsOn) for (const e of w.greekEditions ?? []) if (e.id !== 'tlg' && !greek.includes(e.full)) greek.push(e.full);
  const english = visibleTranslations(w).filter((t) => !t.private).map((t) => englishCite(w, t));
  return { id: w.id, title: w.title, greek, english };
});

const pageTitle = `Texts & Licences — ${siteName}`;
const metaDescription =
  `The Greek editions and English translations of every play on ${siteName}, with their licences.`;
const canonical = Astro.site ? new URL(`${base}/attribution/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og-default.png`, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: metaDescription,
  ...(canonical ? { url: canonical } : {}),
  isPartOf: { '@type': 'WebSite', name: siteName },
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:site_name" content={siteName} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <script type="application/ld+json" set:html={jsonLdSafe(jsonLd)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Alegreya+Sans+SC:wght@500;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <style>
    .attr-body {
      max-width: 680px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
      font-family: var(--font-english);
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text);
    }
    h2 { font: 400 1.6rem/1.2 var(--font-english); color: var(--ink); margin: 2.4rem 0 .4rem; }
    h2:first-of-type { margin-top: 1rem; }
    h3 { font: 400 .95rem var(--font-ui); color: var(--mid); margin: .9rem 0 .25rem; }
    p { margin: 0 0 0.6rem; }
    ul { margin: 0 0 0.6rem; padding-left: 0; list-style: none; }
    li { margin: 0 0 0.35rem; padding-left: 1.2em; text-indent: -1.2em; }
    a { color: var(--accent); }
    .play h2 { font-size: 1.35rem; margin-top: 1.8rem; }
  </style>
  <Pwa />
</head>
<body>
  <div class="wrap"><SiteHeader /></div>

  <main class="attr-body">
    <h1 class="sr-only">Texts and licences for {siteName}</h1>
    <h2>Texts &amp; Licences</h2>
    <p>The Greek editions and English translations of each play, then the licences.</p>

    {plays.map((pl) => (
      <section class="play" id={pl.id}>
        <h2>{pl.title}</h2>
        <h3>Greek</h3>
        <ul>{pl.greek.map((g) => <li>{g}</li>)}</ul>
        <h3>English</h3>
        <ul>{pl.english.map((c) => <li>{c.href ? <a href={c.href}>{c.text}</a> : c.text}</li>)}</ul>
      </section>
    ))}

    <h2>Greek lexicon</h2>
    <p>
      Henry George Liddell and Robert Scott, <em>A Greek-English Lexicon</em>,
      rev. Henry Stuart Jones with Roderick McKenzie, 9th ed. (Oxford:
      Clarendon Press, 1940), with the 1996 supplement; machine-readable
      version by the <a href="https://www.perseus.tufts.edu/">Perseus Digital Library</a>,
      Tufts University. Served by <a href="https://grammata.pages.dev/">Grammata</a>.
    </p>

    <h2 id="drawings">Drawings</h2>
    <ul>
      {servedDrawings().map((d) => (
        <li><strong>{d.alt}.</strong> {d.credit}</li>
      ))}
    </ul>

    <h2 id="licences">Licences</h2>
    <ul>
      <li>
        Texts from the <a href="https://github.com/PerseusDL/canonical-greekLit">Perseus Digital Library</a>
        (the English of Smyth, Jebb, Coleridge, Buckley, and Hickie's <em>Clouds</em>, and the Greek of
        the Smyth, Storr, Murray, and Hall and Geldart editions):
        <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. This site's data
        derived from them carries the same licence.
      </li>
      <li>
        Morshead's translations, from <a href="https://en.wikisource.org/">Wikisource</a>:
        <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.
      </li>
      <li>
        The Kosmos Society translations:
        <a href="https://creativecommons.org/licenses/by-nc-nd/3.0/">CC BY-NC-ND 3.0</a>, reproduced
        without change.
      </li>
      <li>
        Arrowsmith's <em>Birds</em> and <em>Clouds</em>, University of Michigan Press:
        <a href="https://creativecommons.org/publicdomain/mark/1.0/">Public Domain Mark 1.0</a>.
      </li>
      <li>
        Ian Johnston's translations: used under <a href="https://web.viu.ca/johnstoi/copyright.htm">his terms</a>.
      </li>
      <li>
        The LSJ lexicon:
        <a href="https://creativecommons.org/licenses/by-sa/3.0/us/">CC BY-SA 3.0 US</a>.
      </li>
      <li>
        This site's code: <a href="https://opensource.org/licenses/MIT">MIT</a>. Data derived from
        CC BY-SA sources stays under CC BY-SA.
      </li>
    </ul>
    <p>
      Site by <a href="https://johnhboyer.com" target="_blank" rel="noopener">John H. Boyer</a>.
    </p>
  </main>
  <div class="wrap"><SiteFoot /></div>
</body>
</html>
