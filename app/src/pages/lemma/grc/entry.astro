---
import SkipLink from '../../../components/SkipLink.astro';
// One client-rendered Greek lexicon entry. The corpus can grow without adding
// a static page for every lemma; the index remains the lexicon's directory.
import ThemeInit from '../../../components/ThemeInit.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFoot from '../../../components/SiteFoot.astro';
import Pwa from '../../../components/Pwa.astro';
import LemmaEntry from '../../../components/LemmaEntry.svelte';
import { SITE_NAME } from '../../../lib/site';
import '@shared/styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const siteName = SITE_NAME;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>Greek Lexicon — {siteName}</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
  <Pwa />
</head>
<body>
  <SkipLink />
  <div class="wrap"><SiteHeader /></div>
  <span id="main" tabindex="-1"></span>
  <LemmaEntry client:load lang="grc" />
  <div class="wrap"><SiteFoot /></div>
  <style is:global>
    /* No sideways scroll (spec §3.4): a headword longer than the page breaks. */
    .lx-head-gk, .lx-translit { overflow-wrap: anywhere; }
  </style>
</body>
</html>
